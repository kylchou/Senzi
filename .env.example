# Copy to .env and fill in. Never commit .env.

# Postgres. `docker compose up -d` gives you these two.
DATABASE_URL="postgresql://senzi:senzi@localhost:5432/senzi"
# Integration tests wipe this database; its name must end in _test.
TEST_DATABASE_URL="postgresql://senzi:senzi@localhost:5432/senzi_test"

# Clerk (dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# Clerk webhook signing secret for /api/users/webhooks/clerk (optional locally)
CLERK_WEBHOOK_SIGNING_SECRET=""

# Comma-separated emails that become platform admins on first sign-in.
SENZI_ADMIN_EMAILS=""

# Local dev only: lets one admin both propose and approve a market resolution.
# Ignored in production, where a second admin must always approve.
SENZI_ALLOW_SELF_APPROVAL=""

# Seed only: your email becomes an admin and owner of the demo VC org once you sign in.
SEED_DEMO_EMAIL=""

# Demo only: a VC who enters this code on /onboarding skips admin review. Leave empty to disable.
DEMO_VC_BYPASS_CODE=""

# Baseline model collectors (Felix). Only needed to run `npm run scrape`.
# SEC requires "<name or org> <contact email>" for EDGAR access.
SEC_USER_AGENT="Senzi research contact@example.com"
# GitHub token with no scopes; raises the API limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=""

# Bearer secret for the Vercel crons (closing expired markets, VC sync and alerts).
CRON_SECRET=""

# VC Intelligence AI assistant: which data may be sent to an AI provider.
# "standard" (default) excludes restricted studies and private firm notes;
# "extended" includes them and needs explicit team approval first.
VC_ASSISTANT_DATA_TIER="standard"

# Tyche, the VC AI research assistant (Meta Model API, Muse Spark). Put the real
# key in .env.local, which git ignores; never in code. Tyche stays off without it.
SENZI_AI_ASSISTANT_API_KEY=""
# Optional; defaults to muse-spark-1.3. Never use a "-contributor" model: Meta
# trains on prompts sent to those, which would include private VC research.
SENZI_AI_ASSISTANT_MODEL=""
