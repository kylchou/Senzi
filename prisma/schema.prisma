// Senzi database schema.
//
// Owned by Kyler (backend). Felix, Darsh, and Sahil: request changes through
// Kyler rather than editing this file directly.
//
// Conventions
// - IDs are cuids (strings). Timestamps are UTC.
// - Credits are virtual whole-number units with no cash value (Int).
// - Probabilities are stored as fractions in [0, 1] (Float).
// - Opening baselines, community estimates (allocation share or market price),
//   and calibrated probabilities are distinct measurements and live in
//   distinct columns.
// - CHECK constraints and triggers that Prisma cannot express are written by
//   hand in the migration SQL.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Platform-wide role. ADMIN manages startups/markets, reviews studies, and resolves markets.
enum PlatformRole {
  USER
  ADMIN
}

/// Role inside a VC organization. Ordered from most to least privileged.
enum OrgRole {
  OWNER
  ADMIN
  ANALYST
  VIEWER
}

enum StartupStage {
  PRE_SEED
  SEED
  SERIES_A
  SERIES_B
  SERIES_C
  GROWTH
  PUBLIC
  ACQUIRED
  SHUT_DOWN
}

enum MarketStatus {
  DRAFT // being authored; not visible outside admin tools
  OPEN // accepting forecasts
  CLOSED // past deadline or manually closed; awaiting resolution
  RESOLVED // resolution recorded (see Resolution.settlementStatus)
  CANCELLED // voided; stakes are refunded by settlement
}

/// Same values as StudyVisibility. Non-PUBLIC markets belong to an organization
/// and come from a private research study.
enum MarketVisibility {
  PUBLIC // listed in the community platform
  ORGANIZATION // members of Market.organization
  RESTRICTED // org owners/admins, the study author, and study participants
}

enum ForecastSide {
  YES
  NO
}

enum ForecastStatus {
  ACTIVE
  SETTLED
  REFUNDED
}

/// VOID covers questions that can no longer be fairly answered; stakes are refunded.
enum ResolutionOutcome {
  YES
  NO
  VOID
}

enum SettlementStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum CreditTransactionType {
  SIGNUP_GRANT
  ADMIN_GRANT
  ADMIN_ADJUSTMENT
  FORECAST_STAKE
  FORECAST_REVERSAL
  SETTLEMENT_PAYOUT
  MARKET_REFUND
  ACHIEVEMENT_REWARD
}

enum SnapshotTrigger {
  OPENING
  FORECAST
  MODEL_UPDATE
  SETTLEMENT
}

/// What a community estimate number is. An allocation share is not a probability.
enum EstimateKind {
  ALLOCATION_SHARE
  MARKET_PRICE
}

enum StudyStatus {
  DRAFT
  SUBMITTED
  APPROVED
  OPEN
  CLOSED
  RESOLVED
  REJECTED
  CANCELLED
}

enum StudyVisibility {
  PUBLIC
  ORGANIZATION
  RESTRICTED
}

enum WatchlistItemType {
  STARTUP
  STUDY
}

enum VcAlertType {
  FORECAST_MOVEMENT
  DEADLINE_APPROACHING
  STUDY_RESOLVED
  STUDY_STATUS_CHANGED
}

/// Where a model data point came from (Felix's baseline model).
enum ModelSource {
  NPM
  PYPISTATS
  GITHUB
  SEC_EDGAR
  GREENHOUSE
  ASHBY
  WORKABLE
  TRANCO
  HN_ALGOLIA
  SPONSOR
}

enum DataProvenance {
  SCRAPED
  SPONSOR_PROVIDED
}

enum BaselineStatus {
  OK
  INSUFFICIENT_DATA
  OBSERVED
}

enum NewsVerification {
  UNVERIFIED
  VERIFIED
  DISPUTED
}

enum NotificationType {
  MARKET_CLOSING
  MARKET_RESOLVED
  FORECAST_SETTLED
  CREDITS_GRANTED
  STUDY_INVITE
  ORG_INVITE
  ACHIEVEMENT_EARNED
  SYSTEM
}

// ---------------------------------------------------------------------------
// Identity & organizations
// ---------------------------------------------------------------------------

model User {
  id            String       @id @default(cuid())
  /// Subject ID from the auth provider (Clerk user id).
  authId        String       @unique
  email         String       @unique
  username      String?      @unique
  displayName   String
  avatarUrl     String?
  bio           String?
  platformRole  PlatformRole @default(USER)
  /// Cached balance. The CreditTransaction ledger is authoritative; this
  /// column is only ever changed together with a ledger row (lib/credits.ts).
  /// CHECK (creditBalance >= 0).
  creditBalance Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  memberships            OrganizationMembership[]
  invitedMembers         OrganizationMembership[] @relation("MembershipInvitedBy")
  forecasts              Forecast[]
  creditTransactions     CreditTransaction[]      @relation("CreditTransactionUser")
  creditActions          CreditTransaction[]      @relation("CreditTransactionActor")
  notifications          Notification[]
  achievements           UserAchievement[]
  createdStartups        Startup[]
  createdMarkets         Market[]                 @relation("MarketCreatedBy")
  resolutions            Resolution[]
  createdNews            NewsItem[]
  createdStudies         ResearchStudy[]          @relation("StudyCreatedBy")
  studyParticipations    StudyParticipant[]       @relation("StudyParticipantUser")
  addedParticipants      StudyParticipant[]       @relation("StudyParticipantAddedBy")
  studyEvents            StudyEvent[]
  studyNotes             StudyNote[]
  createdWatchlists      Watchlist[]
  watchlistItemsAdded    WatchlistItem[]
  alertReceipts          VcAlertReceipt[]
  createdReports         VcReport[]
  modelDataPointsEntered ModelDataPoint[]
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships     OrganizationMembership[]
  markets         Market[]
  studies         ResearchStudy[]
  studyNotes      StudyNote[]
  watchlists      Watchlist[]
  alerts          VcAlert[]
  reports         VcReport[]
  modelDataPoints ModelDataPoint[]
}

model OrganizationMembership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole  @default(VIEWER)
  invitedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("MembershipInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Startups & markets
// ---------------------------------------------------------------------------

model Startup {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  tagline      String
  description  String
  websiteUrl   String?
  logoUrl      String?
  industry     String
  stage        StartupStage
  foundedYear  Int?
  headquarters String?
  /// Unpublished startups are visible only in admin tools.
  isPublished  Boolean      @default(false)
  createdById  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  createdBy       User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  facts           StartupFact[]
  markets         Market[]
  news            NewsItem[]
  studies         ResearchStudy[]
  watchlistItems  WatchlistItem[]
  modelDataPoints ModelDataPoint[]

  @@index([industry])
  @@index([isPublished, name])
}

/// Public, sourced information about a startup. Every fact cites a source;
/// `verified` means an admin checked it against that source.
model StartupFact {
  id         String   @id @default(cuid())
  startupId  String
  label      String
  value      String
  sourceName String
  sourceUrl  String
  asOf       DateTime
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId])
}

model Market {
  id                  String           @id @default(cuid())
  slug                String           @unique
  startupId           String
  /// The YES/NO question, e.g. "Will Acme announce a Series B by 2027-06-30?"
  question            String
  description         String?
  /// Measurable conditions for YES and for NO. Both required.
  yesCriteria         String
  noCriteria          String
  category            String?
  status              MarketStatus     @default(DRAFT)
  visibility          MarketVisibility @default(PUBLIC)
  /// Required when visibility is not PUBLIC (CHECK constraint).
  organizationId      String?
  opensAt             DateTime
  /// Forecasting deadline. CHECK (closesAt > opensAt).
  closesAt            DateTime
  /// Date by which the market is expected to be resolved.
  resolvesBy          DateTime?
  /// Starting probability of YES in (0, 1), with how it was derived. Set by an
  /// admin or the model service; frozen once the first forecast is accepted.
  openingBaseline     Float?
  baselineMethodology String?
  baselineSetAt       DateTime?
  /// Latest model value of YES (from the model service). Never moved by forecasts.
  modelValue          Float?
  modelVersion        String?
  modelInputsNote     String?
  modelUpdatedAt      DateTime?
  /// Optional per-forecast limits in credits (inclusive).
  minForecastCredits  Int?
  maxForecastCredits  Int?
  /// Aggregates maintained by the forecasting engine in the same transaction
  /// as each forecast. Allocation share = yesCredits / (yesCredits + noCredits).
  yesCredits          Int              @default(0)
  noCredits           Int              @default(0)
  forecastCount       Int              @default(0)
  createdById         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  startup                Startup                 @relation(fields: [startupId], references: [id], onDelete: Restrict)
  organization           Organization?           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy              User?                   @relation("MarketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// The private research study this market was opened from, if any.
  study                  ResearchStudy?
  sources                MarketSource[]
  forecasts              Forecast[]
  snapshots              MarketSnapshot[]
  resolution             Resolution?
  creditTxns             CreditTransaction[]
  news                   NewsItem[]
  modelQuestionSpec      ModelQuestionSpec?
  modelBaselineSnapshots ModelBaselineSnapshot[]

  @@index([status, visibility, closesAt])
  @@index([startupId])
  @@index([organizationId])
}

/// Where the resolver will look for evidence (filings, press, registries...).
model MarketSource {
  id          String    @id @default(cuid())
  marketId    String
  title       String
  url         String
  publisher   String?
  publishedAt DateTime?
  position    Int       @default(0)

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId, position])
}

/// Immutable record of one accepted forecast.
model Forecast {
  id                String         @id @default(cuid())
  userId            String
  marketId          String
  /// 1-based position in the market's forecast sequence.
  sequence          Int
  side              ForecastSide
  /// Credits staked. CHECK (credits > 0).
  credits           Int
  /// Optional probability of YES the forecaster states, in [0, 1]. Used for
  /// calibration scoring, not for payouts.
  statedProbability Float?
  /// Client-supplied key; resubmitting the same key returns the original forecast.
  idempotencyKey    String
  /// Hash of the request payload, to detect a key reused with a different payload.
  requestHash       String
  /// The user was a verified user of the startup's product when forecasting.
  verifiedAtEntry   Boolean        @default(false)
  /// Market state captured at entry (baseline, model, estimates before/after).
  entry             Json
  /// Pricing-rule-specific fill details (e.g. LMSR shares).
  fill              Json?
  status            ForecastStatus @default(ACTIVE)
  /// Credits returned at settlement (0 for a losing forecast).
  payout            Int?
  settledAt         DateTime?
  createdAt         DateTime       @default(now())

  user       User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  market     Market              @relation(fields: [marketId], references: [id], onDelete: Restrict)
  creditTxns CreditTransaction[]

  @@unique([userId, idempotencyKey])
  @@unique([marketId, sequence])
  @@index([userId, createdAt])
  @@index([marketId, status])
}

/// Append-only, point-in-time record of a market's estimates. Every
/// measurement has its own column so they are never conflated.
model MarketSnapshot {
  id                     String          @id @default(cuid())
  marketId               String
  /// Monotonic per market.
  sequence               Int
  trigger                SnapshotTrigger
  /// The forecast that caused this snapshot, if any.
  forecastId             String?
  openingBaseline        Float?
  modelValue             Float?
  yesCredits             Int
  noCredits              Int
  /// yesCredits / (yesCredits + noCredits); null when no credits are allocated.
  allocationShare        Float?
  /// Community estimate from all forecasts under the configured rule.
  generalEstimate        Float?
  /// Same rule replayed over verified users' forecasts only.
  specializedEstimate    Float?
  estimateRuleId         String?
  estimateKind           EstimateKind?
  /// Only set once a calibration report supports calling it a probability.
  calibratedProbability  Float?
  forecastCount          Int
  forecasterCount        Int
  specializedForecasters Int             @default(0)
  specializedCredits     Int             @default(0)
  recordedAt             DateTime        @default(now())

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([marketId, sequence])
  @@index([marketId, recordedAt])
}

model Resolution {
  id                String            @id @default(cuid())
  marketId          String            @unique
  outcome           ResolutionOutcome
  /// Human-readable explanation of why the criteria were (not) met.
  evidenceSummary   String
  /// Links to the documented evidence. At least one (CHECK constraint).
  evidenceUrls      String[]
  resolvedById      String?
  resolvedAt        DateTime          @default(now())
  settlementStatus  SettlementStatus  @default(PENDING)
  /// Which settlement model paid this out (set by the forecasting engine).
  settlementModelId String?
  settledAt         DateTime?
  settlementError   String?

  market     Market              @relation(fields: [marketId], references: [id], onDelete: Restrict)
  resolvedBy User?               @relation(fields: [resolvedById], references: [id], onDelete: SetNull)
  creditTxns CreditTransaction[]

  @@index([settlementStatus])
}

// ---------------------------------------------------------------------------
// Virtual credit ledger (append-only)
// ---------------------------------------------------------------------------

/// Every change to User.creditBalance has exactly one row here. Rows are never
/// updated or deleted. Credits are virtual and have no cash value.
model CreditTransaction {
  id             String                @id @default(cuid())
  /// Insert order. Assigned while the user's row lock is held, so for any one
  /// user it matches the order balances were applied (unlike createdAt).
  sequence       Int                   @unique @default(autoincrement())
  userId         String
  /// Signed amount: positive credits the user, negative debits. CHECK (amount <> 0).
  amount         Int
  /// User.creditBalance immediately after this row was applied. CHECK (>= 0).
  balanceAfter   Int
  type           CreditTransactionType
  /// Globally unique key that makes the write idempotent, e.g.
  /// "forecast:<forecastId>" or "settlement:<marketId>:<forecastId>".
  idempotencyKey String                @unique
  marketId       String?
  forecastId     String?
  resolutionId   String?
  /// Admin who initiated the transaction, when applicable.
  actorId        String?
  memo           String?
  createdAt      DateTime              @default(now())

  user       User        @relation("CreditTransactionUser", fields: [userId], references: [id], onDelete: Restrict)
  actor      User?       @relation("CreditTransactionActor", fields: [actorId], references: [id], onDelete: Restrict)
  market     Market?     @relation(fields: [marketId], references: [id], onDelete: Restrict)
  forecast   Forecast?   @relation(fields: [forecastId], references: [id], onDelete: Restrict)
  resolution Resolution? @relation(fields: [resolutionId], references: [id], onDelete: Restrict)

  @@index([userId, sequence])
  @@index([marketId])
  @@index([forecastId])
  @@index([resolutionId])
  @@index([type, createdAt])
}

// ---------------------------------------------------------------------------
// VC Intelligence (Darsh)
// ---------------------------------------------------------------------------

/// One private research question from a VC firm. Lifecycle:
/// DRAFT -> SUBMITTED -> APPROVED -> OPEN -> CLOSED -> RESOLVED, with REJECTED
/// and CANCELLED side branches. Opening creates the linked Market.
model ResearchStudy {
  id                  String             @id @default(cuid())
  organizationId      String
  createdById         String
  startupId           String
  /// Set when the study opens; the market is created by lib/admin.ts createMarketForStudy.
  marketId            String?            @unique
  question            String
  yesCriteria         String
  noCriteria          String
  context             String?
  /// Opening baseline in (0, 1) and how it was derived.
  baselineValue       Float?
  baselineMethodology String?
  deadline            DateTime
  visibility          StudyVisibility    @default(ORGANIZATION)
  status              StudyStatus        @default(DRAFT)
  rejectionReason     String?
  cancellationReason  String?
  submittedAt         DateTime?
  approvedAt          DateTime?
  openedAt            DateTime?
  closedAt            DateTime?
  resolvedAt          DateTime?
  resolvedOutcome     ResolutionOutcome?
  /// Optimistic concurrency: every transition compares and increments this.
  version             Int                @default(1)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User               @relation("StudyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  startup        Startup            @relation(fields: [startupId], references: [id], onDelete: Restrict)
  market         Market?            @relation(fields: [marketId], references: [id], onDelete: Restrict)
  sources        StudySource[]
  participants   StudyParticipant[]
  events         StudyEvent[]
  notes          StudyNote[]
  reports        VcReport[]
  watchlistItems WatchlistItem[]

  @@index([organizationId, status])
  @@index([visibility, status])
  @@index([startupId])
}

model StudySource {
  id          String    @id @default(cuid())
  studyId     String
  url         String
  title       String
  publisher   String?
  publishedAt DateTime?
  position    Int       @default(0)

  study ResearchStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([studyId])
}

/// People invited to a study, possibly from outside the organization.
model StudyParticipant {
  studyId   String
  userId    String
  addedById String
  createdAt DateTime @default(now())

  study   ResearchStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
  user    User          @relation("StudyParticipantUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User          @relation("StudyParticipantAddedBy", fields: [addedById], references: [id], onDelete: Restrict)

  @@id([studyId, userId])
  @@index([userId])
}

/// Append-only trail of study lifecycle transitions.
model StudyEvent {
  id         String       @id @default(cuid())
  studyId    String
  /// Null for system actions.
  actorId    String?
  action     String
  fromStatus StudyStatus?
  toStatus   StudyStatus
  reason     String?
  createdAt  DateTime     @default(now())

  study ResearchStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
  actor User?         @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([studyId, createdAt])
}

/// Private to the owning organization. Never exposed through public APIs.
model StudyNote {
  id             String   @id @default(cuid())
  studyId        String
  organizationId String
  authorId       String
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  study        ResearchStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([studyId, createdAt])
}

model Watchlist {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items        WatchlistItem[]

  @@unique([organizationId, name])
}

/// Exactly one of startupId / studyId is set, matching `type` (CHECK constraint).
model WatchlistItem {
  id          String            @id @default(cuid())
  watchlistId String
  type        WatchlistItemType
  startupId   String?
  studyId     String?
  addedById   String
  createdAt   DateTime          @default(now())

  watchlist Watchlist      @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  startup   Startup?       @relation(fields: [startupId], references: [id], onDelete: Cascade)
  study     ResearchStudy? @relation(fields: [studyId], references: [id], onDelete: Cascade)
  addedBy   User           @relation(fields: [addedById], references: [id], onDelete: Restrict)

  @@unique([watchlistId, startupId])
  @@unique([watchlistId, studyId])
}

model VcAlert {
  id             String      @id @default(cuid())
  organizationId String
  type           VcAlertType
  studyId        String?
  startupId      String?
  marketId       String?
  title          String
  body           String
  payload        Json        @default("{}")
  dedupeKey      String
  createdAt      DateTime    @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receipts     VcAlertReceipt[]

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, createdAt])
}

/// Per-user read state for organization alerts.
model VcAlertReceipt {
  alertId String
  userId  String
  readAt  DateTime @default(now())

  alert VcAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([alertId, userId])
}

/// Frozen report snapshot. Access is re-checked against the study on every read.
model VcReport {
  id             String   @id @default(cuid())
  organizationId String
  studyId        String
  createdById    String
  title          String
  content        Json
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  study        ResearchStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
  createdBy    User          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
}

// ---------------------------------------------------------------------------
// Baseline model (Felix). Proposal: docs/model-schema-proposal.md
// ---------------------------------------------------------------------------

/// One observed value for a startup metric. Scraped rows are public; sponsor
/// rows are private to organizationId (see lib/permissions.ts) and never
/// resolve a market. CHECK constraints tie provenance to source and org.
model ModelDataPoint {
  id             String         @id @default(cuid())
  startupId      String
  /// e.g. "npm_downloads:@supabase/supabase-js", "open_jobs", "sponsor_arr"
  metricId       String
  source         ModelSource
  value          Float
  periodStart    DateTime       @db.Date
  periodEnd      DateTime       @db.Date
  /// When the value became publicly knowable. Backtests filter on this.
  availableAt    DateTime
  fetchedAt      DateTime
  sourceUrl      String
  provenance     DataProvenance
  /// True for made-up demo values. Always false for scraped data.
  simulated      Boolean        @default(false)
  note           String?
  /// Sponsor-provided rows only: the sponsor org that entered it.
  organizationId String?
  /// Sponsor-provided rows only.
  enteredById    String?
  createdAt      DateTime       @default(now())

  startup      Startup       @relation(fields: [startupId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enteredBy    User?         @relation(fields: [enteredById], references: [id], onDelete: SetNull)

  /// Re-fetching the same period updates the row. The migration makes this
  /// NULLS NOT DISTINCT so scraped rows (organizationId null) dedupe too.
  @@unique([startupId, metricId, source, periodStart, periodEnd, organizationId])
  @@index([startupId, metricId, periodEnd])
  @@index([availableAt])
}

/// Makes a Market machine-resolvable: "Will <metric> in the <windowDays> days
/// ending <windowEnd> be at least <threshold>?" The resolution source can't
/// change once the market has opened (database trigger).
model ModelQuestionSpec {
  id                  String      @id @default(cuid())
  marketId            String      @unique
  metricId            String
  threshold           Float
  /// Last day (inclusive, UTC) of the window.
  windowEnd           DateTime    @db.Date
  windowDays          Int         @default(7)
  resolutionSource    ModelSource
  resolutionSourceUrl String
  createdAt           DateTime    @default(now())

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
}

/// A computed baseline. A new row is written only when inputsHash changes.
/// The latest row is the model line.
model ModelBaselineSnapshot {
  id           String         @id @default(cuid())
  marketId     String
  status       BaselineStatus
  /// Null when status = INSUFFICIENT_DATA.
  probability  Float?
  low          Float?
  high         Float?
  /// "low" | "medium" | "high"
  confidence   String?
  asOf         DateTime
  /// Last day of data the result is based on.
  dataThrough  DateTime?      @db.Date
  modelName    String
  modelVersion String
  inputsHash   String
  /// Full method details: mu, sigma, weeks used, horizon, seed, ...
  method       Json
  /// [{ metricId, source, provenance, simulated, role, points, periodStart, periodEnd }]
  inputsUsed   Json
  /// [{ source, url, fetchedAt }]
  sources      Json
  missing      String[]
  notes        String[]
  createdAt    DateTime       @default(now())

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([marketId, inputsHash])
  @@index([marketId, createdAt])
}

/// Audit trail for collection and backtest runs.
model ModelRun {
  id           String    @id @default(cuid())
  /// "collect" | "backtest"
  kind         String
  modelVersion String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  /// Collection report (counts, missing data, errors) or backtest results.
  report       Json

  @@index([kind, startedAt])
}

// ---------------------------------------------------------------------------
// Content, engagement & audit
// ---------------------------------------------------------------------------

model NewsItem {
  id           String           @id @default(cuid())
  startupId    String?
  marketId     String?
  title        String
  summary      String?
  publisher    String
  url          String
  publishedAt  DateTime
  /// Whether an admin has verified the reported facts against the source.
  verification NewsVerification @default(UNVERIFIED)
  createdById  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  startup   Startup? @relation(fields: [startupId], references: [id], onDelete: Cascade)
  market    Market?  @relation(fields: [marketId], references: [id], onDelete: SetNull)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([startupId, publishedAt])
  @@index([marketId])
  @@index([publishedAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  /// Relative in-app link, e.g. "/markets/acme-series-b".
  link      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Achievement {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  description  String
  icon         String?
  /// Virtual credits granted when earned (via the ledger). CHECK (>= 0).
  creditReward Int      @default(0)
  createdAt    DateTime @default(now())

  awards UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  awardedAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

/// Append-only record of security-relevant and administrative actions.
/// actorId / organizationId are deliberately plain columns (no foreign keys)
/// so the trail survives deletion of the user or organization it refers to.
model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  organizationId String?
  /// Dotted verb, e.g. "market.create", "market.resolve", "credits.grant".
  action         String
  entityType     String
  entityId       String
  data           Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([organizationId, createdAt])
  @@index([action, createdAt])
}
